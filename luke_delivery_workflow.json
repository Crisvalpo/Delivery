        "options": {}
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2,
      "position": [440, 160],
      "id": "email-send-admin",
      "name": "Enviar Correo Alerta",
      "credentials": {
        "smtp": {
          "id": "SMTP-Placeholder-Credentials-Luke"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.whatsapp-provider.com/message/sendText",
        "sendHeaders": true,
        "headerParameters": {
